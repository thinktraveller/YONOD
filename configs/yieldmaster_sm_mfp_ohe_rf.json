{
  "version": "1.0",
  "project_name": "yieldmaster_sm_mfp_ohe_rf",
  "origin_dataset_path": "../dataset/yieldmaster/SM.csv",
  "column_mapping": [
    {"origin_name": "reactant_1_smiles", "role": "reactant", "new_name": "reactant_1_smiles"},
    {"origin_name": "reactant_2_smiles", "role": "reactant", "new_name": "reactant_2_smiles"},
    {"origin_name": "ligand_smiles", "role": "others", "new_name": "ligand_smiles"},
    {"origin_name": "reagent_1_smiles", "role": "others", "new_name": "reagent_1_smiles"},
    {"origin_name": "solvent_1_smiles", "role": "others", "new_name": "solvent_1_smiles"},
    {"origin_name": "Yield", "role": "label", "new_name": "Yield"}
  ],
  "column_roles": {
    "label": "Yield",
    "reactants": ["reactant_1_smiles", "reactant_2_smiles"],
    "products": [],
    "others": ["ligand_smiles", "reagent_1_smiles", "solvent_1_smiles"],
    "conditions": []
  },
  "descriptors": [
    {
      "id": "mfp_vjethbkm",
      "descriptor": "mfp",
      "mode": "concat",
      "columns": ["reactant_1_smiles", "reactant_2_smiles", "ligand_smiles", "reagent_1_smiles", "solvent_1_smiles"],
      "params": {"radius": 3, "fp_size": 1024, "profile": "vjethbkm"}
    },
    {
      "id": "ohe_train_fold",
      "descriptor": "ohe",
      "mode": "concat",
      "columns": ["reactant_1_smiles", "reactant_2_smiles", "ligand_smiles", "reagent_1_smiles", "solvent_1_smiles"],
      "params": {"missing_policy": "zero_block", "dtype": "float64", "handle_unknown": "ignore"}
    }
  ],
  "models": ["Random Forest"],
  "metadata": {
    "doi": "10.1021/jacs.6c02213",
    "notes": "SM 原始 CSV 共 5,760 行；ligand_smiles 缺失 480 行，reagent_1_smiles 缺失 720 行。该统一 YONOD 任务保留所有行，并对缺失组分使用零块编码；因此不等同于论文仅对 MFP 使用的 4,620 行人群。仅执行随机森林、MFP 和训练折 OHE。运行命令：python main.py --json configs/yieldmaster_sm_mfp_ohe_rf.json --csv dataset/yieldmaster/SM.csv。必须提供 --csv，因为 JSON 模式默认查找配置文件同级的规范化数据集。"
  },
  "report_formats": ["HTML", "Markdown"]
}
