{
  "version": "1.0",
  "project_name": "yieldmaster_bh1_mfp_ohe_rf",
  "origin_dataset_path": "../dataset/yieldmaster/BH1.csv",
  "column_mapping": [
    {"origin_name": "Aryl_halide_SMILES", "role": "reactant", "new_name": "Aryl_halide_SMILES"},
    {"origin_name": "Additive_SMILES", "role": "others", "new_name": "Additive_SMILES"},
    {"origin_name": "Base_SMILES", "role": "others", "new_name": "Base_SMILES"},
    {"origin_name": "Ligand_SMILES", "role": "others", "new_name": "Ligand_SMILES"},
    {"origin_name": "Yield", "role": "label", "new_name": "Yield"}
  ],
  "column_roles": {
    "label": "Yield",
    "reactants": ["Aryl_halide_SMILES"],
    "products": [],
    "others": ["Additive_SMILES", "Base_SMILES", "Ligand_SMILES"],
    "conditions": []
  },
  "descriptors": [
    {
      "id": "mfp_vjethbkm",
      "descriptor": "mfp",
      "mode": "concat",
      "columns": ["Aryl_halide_SMILES", "Additive_SMILES", "Base_SMILES", "Ligand_SMILES"],
      "params": {"radius": 3, "fp_size": 1024, "profile": "vjethbkm"}
    },
    {
      "id": "ohe_train_fold",
      "descriptor": "ohe",
      "mode": "concat",
      "columns": ["Aryl_halide_SMILES", "Additive_SMILES", "Base_SMILES", "Ligand_SMILES"],
      "params": {"missing_policy": "zero_block", "dtype": "float64", "handle_unknown": "ignore"}
    }
  ],
  "models": ["Random Forest"],
  "metadata": {
    "doi": "10.1021/jacs.6c02213",
    "notes": "BH1: 3,955 rows; MFP and OHE both use all four component columns in the declared paper order."
  },
  "report_formats": ["HTML", "Markdown"],
  "_comments": {
    "execution": "python main.py --json configs/yieldmaster_bh1_mfp_ohe_rf.json --csv dataset/yieldmaster/BH1.csv",
    "scope": "Only Random Forest, MFP and train-fold OHE are declared. The --csv argument is required because main.py JSON mode otherwise expects a normalized CSV beside this config."
  }
}
