{
  "version": "1.0",
  "project_name": "yieldmaster_sl1_mfp_ohe_outercv_20260908",
  "origin_dataset_path": "../../dataset/yieldmaster/SL1.csv",
  "column_mapping": [
    {
      "origin_name": "Aldehyde_1",
      "role": "reactant",
      "new_name": "Aldehyde_1"
    },
    {
      "origin_name": "bifunctional_reagent",
      "role": "others",
      "new_name": "bifunctional_reagent"
    },
    {
      "origin_name": "Aldehyde_2",
      "role": "reactant",
      "new_name": "Aldehyde_2"
    },
    {
      "origin_name": "Yield",
