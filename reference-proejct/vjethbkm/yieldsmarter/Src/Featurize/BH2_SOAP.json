      "xyz_template": "Amine_{id}.xyz"
    },
    {
      "name": "Base",
      "reaction_col": "Base_SMILES",
      "lookup_csv": "../../Data/HTE_datasets/BH2/csv/Base_SMILES.csv",
      "lookup_key_col": "Base_SMILES",
      "xyz_template": "Base_{id}.xyz"
    },
    {
      "name": "Bromide",
      "reaction_col": "Bromide_SMILES",
      "lookup_csv": "../../Data/HTE_datasets/BH2/csv/Bromide_SMILES.csv",
      "lookup_key_col": "Bromide_SMILES",
      "xyz_template": "Bromide_{id}.xyz"
    },
    {
      "name": "Ligand",
      "reaction_col": "Ligand_SMILES",
      "lookup_csv": "../../Data/HTE_datasets/BH2/csv/Catalysts_SMILES.csv",
      "lookup_key_col": "Catalysts_SMILES",
      "xyz_template": "Catalysts_{id}.xyz"
    },
    {
      "name": "Solvent",
