# ===================== YONOD runtime artifacts =====================
# Runtime caches (auto-regenerated on first run)
cache/

# Pipeline outputs (regenerate by re-running yonod.py)
results/
!results/.gitkeep

# Large cleaned USPTO corpus is distributed through Hugging Face.
dataset/USPTO/

# AutoGluon dumps trained models here if save_path is provided
AutogluonModels/

# Logs
logs

# ===================== Large model weights =====================
# Binary model weights are hosted at https://huggingface.co/thinktraveller/YONOD-weights.
# Configuration, documentation, and manifests remain ordinary Git files.
# Run `hf download thinktraveller/YONOD-weights --local-dir WEIGHTS` to fetch
# the distributable binaries locally.
# Keep locally downloaded model binaries out of commits while retaining the
# tracked configuration, tokenizer, and conversion-manifest files beside them.
/WEIGHTS/FISD/
/WEIGHTS/MolMetaLM-base/model.safetensors
/WEIGHTS/chemical_vae/**/encoder_state_dict.pt

# Generic large weight file types (not tracked in this repository)
*.safetensors
*.pt
*.pth
*.ckpt



# ===================== Third-party project sources =====================
# These upstream repos are kept locally for reference but not redistributed
# (the original 化学描述符相关项目/FISD/ has its own .git heritage that confuses
# git; the runtime-needed FISD weights are duplicated to WEIGHTS/FISD/).
# Cite upstream projects in README.md instead of vendoring their source here.
start-conda.txt

